{
  "schemaVersion": 1,
  "id": "spatial_gui_extras",
  "version": "${version}",
  "name": "Spatial GUI Extras",
  "description": "Interaction extensions and multiplayer sharing for Spatial GUI.",
  "authors": [
    "McAxolotl"
  ],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "mcaxolotl.spatialguiextras.Extras"
    ],
    "client": [
      "mcaxolotl.spatialguiextras.ExtrasClient"
    ],
    "modmenu": [
      "mcaxolotl.spatialguiextras.config.ModMenuIntegration"
    ]
  },
  "mixins": [
    {
      "config": "spatial_gui_extras.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.18.4",
    "minecraft": "=1.20.1",
    "java": ">=17",
    "fabric-api": "*"
  },
  "recommends": {
    "spatial_gui": "=1.9.1",
    "yet_another_config_lib_v3": ">=3.6.6+1.20.1-fabric"
  }
}
